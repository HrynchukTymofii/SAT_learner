# =============================================================
# SAT Learner — website (Next.js) environment template
# Copy to `.env` and fill in YOUR OWN values. Never commit `.env`.
# =============================================================

# --- Database (PostgreSQL / Neon) ---------------------------
# Prisma needs BOTH. See prisma/schema.prisma:
#   url       = env("DATABASE_URL")            <- pooled, used at runtime
#   directUrl = env("DATABASE_URL_UNPOOLED")   <- direct, used by `prisma migrate`
#
# Neon: Console -> your project -> "Connect" -> copy the string twice,
# once with "Connection pooling" ON and once OFF.
# The only difference is `-pooler` in the hostname.
#
# On any plain Postgres with no pooler, set both to the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Course content -----------------------------------------
# The `id` of the row in the Course table that this deployment serves.
# Run after the data import:  SELECT id, title FROM "Course";
COURSE_ID=""

# Courses shown on the learning platform, in order, comma separated (one PRO covers all).
# Defaults to COURSE_ID. Example: "<math course id>,<reading & writing course id>"
PLATFORM_COURSE_IDS=""

# --- Two hosts: marketing site + learning platform -----------
# One deployment serves both; middleware.ts routes by host name.
#   satlearner.com      -> marketing pages (app/(main))
#   app.satlearner.com  -> learning platform (app/learn)
# Add both domains to the same Vercel project. Leave all three empty for local dev
# (then open app.localhost:3000 for the platform, localhost:3000 for the site).
NEXT_PUBLIC_SITE_URL="https://satlearner.com"
NEXT_PUBLIC_APP_URL="https://app.satlearner.com"
# Shares the login cookie between the two hosts. Note the leading dot.
AUTH_COOKIE_DOMAIN=".satlearner.com"

# --- Secrets you generate yourself --------------------------
# Signs the 60-day tokens used by the mobile app (lib/jwt.ts).
# Generate:  openssl rand -base64 32
# WARNING: changing this logs out every mobile user immediately.
JWT_SECRET=""

# NextAuth session/cookie encryption for the website.
# Generate:  openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public origin of the deployment. No trailing slash. Login lives on the platform,
# so use the app host. Must exactly match the OAuth redirect URIs registered with
# Google/Apple: add https://app.satlearner.com/api/auth/callback/google (and apple).
NEXTAUTH_URL="https://app.satlearner.com"

# --- Google Sign-In -----------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
# -> Create OAuth client ID -> Application type: "Web application"
# Authorised redirect URI:  ${NEXTAUTH_URL}/api/auth/callback/google
#
# This is the WEB client. The mobile app also sends id_tokens minted for this
# same web client (GoogleSignin.configure({ webClientId })), and
# app/api/auth/google/route.ts verifies them against GOOGLE_CLIENT_ID.
# So the web client ID here must match `webClientId` in the mobile app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Sign in with Apple -------------------------------------
# APPLE_ID = your Services ID (Apple Developer -> Identifiers -> Services IDs),
#            e.g. "com.yourcompany.satlearner.web". NOT the app's bundle ID.
#            Configure its "Return URL" as ${NEXTAUTH_URL}/api/auth/callback/apple
APPLE_ID=""

# APPLE_SECRET = an ES256 JWT you generate and sign with a Sign in with Apple
#            key (.p8). It contains iss=<Team ID>, sub=<Services ID>,
#            aud=https://appleid.apple.com, kid=<Key ID> in the header.
#            !! It EXPIRES — Apple allows a maximum lifetime of 6 months,
#            so this must be regenerated on a recurring schedule.
#            Generate: node scripts/generate-apple-secret.mjs (see the comment at its top).
APPLE_SECRET=""

# APPLE_CLIENT_ID = the iOS app's bundle identifier, e.g. "com.hrynchuk.satprepapp".
#            Used as the expected `audience` when verifying the native
#            Apple id_token in app/api/auth/apple/route.ts.
#            This one survives an App Store app transfer unchanged.
APPLE_CLIENT_ID=""

# --- RevenueCat ---------------------------------------------
# Secret API key (starts with "sk_"), used by lib/revenuecat.ts to check
# PRO for website sessions. RevenueCat -> Project settings -> API keys ->
# "+ New secret API key" (v1). Never use it in the app.
# If unset, the website falls back to User.isPro from the DB.
REVENUECAT_SECRET_KEY=""

# ---- Admin panel (app.satlearner.com/admin) ----
# Course admins: these emails AND User.role = 'admin' in the database (both needed).
ADMIN_EMAILS="admin1@example.com,admin2@example.com"

# Cloudflare R2 for course images and lesson videos (uploaded from the admin panel).
# Cloudflare -> R2 -> Manage API tokens -> "Object Read & Write" for this bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sat-media"
# Public URL of the bucket (custom domain like https://media.satlearner.com, or the r2.dev URL). No trailing slash.
R2_PUBLIC_URL=""

# Protects /api/cron/r2-cleanup (weekly cleanup of unused R2 files). Vercel Cron sends it automatically.
CRON_SECRET=""

# --- Push notifications (optional) ---------------------------
# Lets scripts send notifications: POST /api/admin/notifications with
# "Authorization: Bearer <key>". 24+ random characters. Not needed for the admin page.
NOTIFICATIONS_ADMIN_KEY=""
# Only if "Enhanced push security" is turned on in the Expo project (expo.dev -> Access tokens).
EXPO_ACCESS_TOKEN=""
