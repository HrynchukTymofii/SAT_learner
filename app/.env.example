# =============================================================
# SAT Learner — mobile app (Expo) environment template
# Copy to `.env` and fill in YOUR OWN values.
# =============================================================
#
# NOTE: these three are read in app.config.ts and exposed via `extra`.
# Several screens ALSO hardcode the same client IDs inline —
# see app/auth.tsx, app/login.tsx, app/(tabs)/course/index.tsx.
# When you change these values you MUST update those files too,
# plus `iosUrlScheme` in app.config.ts (the reversed iOS client ID).

# Google Cloud Console -> Credentials -> OAuth client ID
# Type "iOS", bundle ID = the value of ios.bundleIdentifier in app.config.ts
IOS_GOOGLE_CLIENT_ID=""

# Type "Android", package name = android.package in app.config.ts,
# SHA-1 = fingerprint of your upload/Play App Signing key
ANDROID_GOOGLE_CLIENT_ID=""

# Type "Web application" — MUST be the same value as GOOGLE_CLIENT_ID in
# website/.env. The app signs in with this as `webClientId`, and the backend
# verifies the resulting id_token against it.
GOOGLE_CLIENT_ID=""
